pipeline
{
agent any
stages
{
stage('checkout')
{
steps{
echo 'Checking out source code'
}
}
stage ('Build')
{
steps{
echo 'Building the application!....'
}
}
stage('Test')
{
steps{
echo 'Testing the application!...'
echo 'application tested successfully!'
}
}
stage ('Deploy')
{
steps{
echo 'Deploying the application!....'
echo 'application deployed successfully!'
}
}
}
}